<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TapeConNET.Tests</RootNamespace>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)..\TapeNET.runsettings</RunSettingsFilePath>
	<!-- Enable IDE0005 reports during build and dotnet format -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CS1591;CS1573;CS0419;</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn>1701;1702;CS1591;CS1573;CS0419;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <!-- Reuse shared helpers from TapeLibNET.Tests via <Link> rather than
        duplicating them or pulling a project reference (which would drag in
        grpc/aspnetcore dependencies of the full physical-test rig). -->
  <ItemGroup>
    <Compile Include="..\TapeLibNET.Tests\Helpers\TempFileTree.cs">
      <Link>Shared\TempFileTree.cs</Link>
    </Compile>
    <Compile Include="..\TapeLibNET.Tests\Helpers\AdsHelper.cs">
      <Link>Shared\AdsHelper.cs</Link>
    </Compile>
    <Compile Include="..\TapeLibNET.Tests\Helpers\FileComparer.cs">
      <Link>Shared\FileComparer.cs</Link>
    </Compile>
    <Compile Include="..\TapeLibNET.Tests\Helpers\TempVirtualMedia.cs">
      <Link>Shared\TempVirtualMedia.cs</Link>
    </Compile>
    <Compile Include="..\TapeLibNET.Tests\Helpers\TestTapeServiceHost.cs">
      <Link>Shared\TestTapeServiceHost.cs</Link>
    </Compile>
    <Compile Include="..\TapeLibNET.Tests\Helpers\TestLoggerFactory.cs">
      <Link>Shared\TestLoggerFactory.cs</Link>
    </Compile>
    <Compile Include="..\TapeLibNET.Tests\Helpers\TestNotifiable.cs">
      <Link>Shared\TestNotifiable.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TapeLibNET\TapeLibNET.csproj" />
    <ProjectReference Include="..\TapeConNET\TapeConNET.csproj" />
  </ItemGroup>

</Project>