<UserControl x:Class="TapeWinNET.Controls.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- One password field: label, box with a "verified" tick, the field's own error (red), a hint (grey).
         Advice, notes and the retry countdown belong in the hosting window's warning pane (W6), not here. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisLocal"/>
        <!-- A TextBlock that takes no space while it has nothing to say -->
        <Style x:Key="CollapseWhenEmpty" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HintWhenNotEmpty" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" Margin="0,0,0,4"
                   Style="{StaticResource CollapseWhenEmpty}"/>
        <Grid>
            <PasswordBox x:Name="Box"
                         VerticalContentAlignment="Center"
                         Padding="2,2,22,2"
                         PasswordChanged="Box_PasswordChanged"
                         PreviewKeyDown="Box_KeyEvent"
                         KeyUp="Box_KeyEvent"
                         GotKeyboardFocus="Box_GotKeyboardFocus"/>
            <TextBlock Text="&#x2713;" FontWeight="Bold"
                       Foreground="{StaticResource WarningFg.Completed}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                       IsHitTestVisible="False"
                       ToolTip="Password verified"
                       Visibility="{Binding IsVerified, ElementName=Root, Converter={StaticResource BoolToVisLocal}}"/>
        </Grid>
        <TextBlock Text="{Binding ErrorText, ElementName=Root}"
                   Foreground="{StaticResource WarningFg.Error}" Margin="0,3,0,0"
                   Style="{StaticResource CollapseWhenEmpty}"/>
        <TextBlock Text="{Binding Hint, ElementName=Root}" Margin="0,3,0,0"
                   Style="{StaticResource HintWhenNotEmpty}"/>
    </StackPanel>
</UserControl>
