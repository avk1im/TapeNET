<Window x:Class="TapeWinNET.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TapeWinNET.Controls"
        xmlns:converters="clr-namespace:TapeWinNET.Converters"
        Title="Password"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- set -->
            <RowDefinition Height="Auto"/>  <!-- prompt -->
            <RowDefinition Height="Auto"/>  <!-- password field -->
            <RowDefinition Height="Auto"/>  <!-- warning pane -->
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="SetText" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="PromptText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <controls:PasswordInput x:Name="Input" Grid.Row="2" Label="Password:"/>

        <!-- Warning pane (W6): Caps Lock, the retry countdown, the attempt, notes, advice — above the buttons -->
        <Border Grid.Row="3" Style="{StaticResource WarningPanelStyle}" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding WarningLevel, Converter={x:Static converters:WarningLevelToIconConverter.Instance}}"
                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OkButton_Click"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
