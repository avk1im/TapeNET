<UserControl x:Class="TapeWinNET.Controls.NewPasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TapeWinNET.Controls"
             x:Name="Root">
    <!-- A NEW password, typed twice (Design-Encryption §11.1.4): two PasswordInput fields — the same rendering as every
         other password field; "don't match" shows in red under Confirm, a match gives Confirm the green tick.
         Advice ("a lost password cannot be recovered") belongs in the hosting window's warning pane (W6). -->
    <StackPanel>
        <controls:PasswordInput x:Name="First"
                                Label="{Binding Label, ElementName=Root}"
                                Hint="Recommended: at least 12 characters"
                                Margin="0,0,0,6"/>
        <controls:PasswordInput x:Name="Confirm"
                                Label="{Binding ConfirmLabel, ElementName=Root}"/>
    </StackPanel>
</UserControl>
