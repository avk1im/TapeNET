<UserControl x:Class="TapeWinNET.Controls.SplitButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:TapeWinNET.Converters"
             mc:Ignorable="d"
             x:Name="Root">
	<UserControl.Resources>
		<converters:ReferenceEqualsConverter x:Key="ReferenceEqualsConverter" />
	</UserControl.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="20"/>
		</Grid.ColumnDefinitions>

		<!-- Main button: performs the default primary action. -->
		<Button Grid.Column="0"
                Content="{Binding ButtonContent, ElementName=Root}"
                Command="{Binding Command, ElementName=Root}"
                CommandParameter="{Binding CommandParameter, ElementName=Root}"
                ToolTip="{Binding ButtonToolTip, ElementName=Root}"
                Padding="10,1"/>

		<!-- Dropdown button: reveals the menu of alternative actions. -->
		<Button x:Name="DropDownButton"
                Grid.Column="1"
                Content="▾"
                Margin="1,0,0,0"
                Padding="2,1"
                Click="DropDownButton_Click"
                ToolTip="{Binding DropDownToolTip, ElementName=Root}">
			<Button.ContextMenu>
				<!--
					ContextMenu runs in a detached popup tree and cannot resolve ElementName
					or ancestor bindings from the caller's visual tree. Forward the arrow
					button's DataContext so menu items share the SplitButton's binding source.
					If commands live on a containing UserControl, set the SplitButton itself:
						DataContext="{Binding ElementName=Root}"
				-->
				<ContextMenu x:Name="DropDownMenu"
                             Placement="Custom"
                             CustomPopupPlacementCallback="DropDownMenu_CustomPopupPlacement"
                             DataContext="{Binding PlacementTarget.DataContext,
                                                   RelativeSource={RelativeSource Self}}">
					<ContextMenu.Resources>
						<Style TargetType="{x:Type MenuItem}">
							<Setter Property="FontWeight" Value="Normal"/>
							<Style.Triggers>
								<DataTrigger Value="True">
									<DataTrigger.Binding>
										<MultiBinding Converter="{StaticResource ReferenceEqualsConverter}">
											<!-- Command associated with this menu item. -->
											<Binding Path="Command"
                                                     RelativeSource="{RelativeSource Self}"/>

											<!-- Main command associated with the SplitButton. -->
											<Binding Path="Tag.Command"
                                                     RelativeSource="{RelativeSource AncestorType=ContextMenu}"/>
										</MultiBinding>
									</DataTrigger.Binding>
									<Setter Property="FontWeight" Value="Bold"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ContextMenu.Resources>
				</ContextMenu>
			</Button.ContextMenu>
		</Button>
	</Grid>
</UserControl>
