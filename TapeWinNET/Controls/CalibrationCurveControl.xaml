<UserControl x:Class="TapeWinNET.Controls.CalibrationCurveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="420"
             MinHeight="220"
             ClipToBounds="True">
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Grid.Column="0"
              Margin="0,10,8,10"
              IsHitTestVisible="False">
            <TextBlock x:Name="ActualTopLabel"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Foreground="Gray"
                       FontSize="11"/>
            <TextBlock x:Name="ActualBottomLabel"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Foreground="Gray"
                       FontSize="11"/>
        </Grid>

        <Border Grid.Row="0"
                Grid.Column="1"
                BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Canvas x:Name="PlotCanvas"
                    Margin="8"/>
        </Border>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="8,6,8,0"
              IsHitTestVisible="False">
            <TextBlock x:Name="ReportedLeftLabel"
                       HorizontalAlignment="Left"
                       Foreground="Gray"
                       FontSize="11"/>
            <TextBlock x:Name="ReportedRightLabel"
                       HorizontalAlignment="Right"
                       Foreground="Gray"
                       FontSize="11"/>
        </Grid>
    </Grid>
</UserControl>
