<UserControl x:Class="TapeWinNET.Controls.CalibrationCurveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="220"
             d:DesignWidth="420">
    <Grid>
        <Border BorderBrush="#D0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <Canvas x:Name="PlotCanvas"
                    Margin="8"
                    Height="180"/>
        </Border>

        <Grid Margin="14,10,14,10"
              IsHitTestVisible="False">
            <TextBlock x:Name="ActualTopLabel"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Foreground="Gray"
                       FontSize="11"/>
            <TextBlock x:Name="ActualBottomLabel"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Foreground="Gray"
                       FontSize="11"/>
            <TextBlock x:Name="ReportedLeftLabel"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="28,0,0,-2"/>
            <TextBlock x:Name="ReportedRightLabel"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Foreground="Gray"
                       FontSize="11"
                       Margin="0,0,0,-2"/>
        </Grid>
    </Grid>
</UserControl>
