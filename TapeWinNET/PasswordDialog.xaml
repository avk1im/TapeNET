<Window x:Class="TapeWinNET.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TapeWinNET.Controls"
        xmlns:converters="clr-namespace:TapeWinNET.Converters"
        xmlns:help="clr-namespace:TapeWinNET.Help"
        Title="Password"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Outer grid: column 0 = dialog content, column 1 = splitter, column 2 = help pane. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>                                       <!-- help splitter -->
            <ColumnDefinition x:Name="HelpPaneColumn" Width="0" MinWidth="0"/>    <!-- help pane    -->
        </Grid.ColumnDefinitions>

        <!-- Dialog content fills column 0 -->
        <Grid x:Name="HelpOverlayRoot" Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- set -->
                <RowDefinition Height="Auto"/>  <!-- prompt -->
                <RowDefinition Height="Auto"/>  <!-- password field -->
                <RowDefinition Height="Auto"/>  <!-- warning pane -->
                <RowDefinition Height="Auto"/>  <!-- buttons -->
            </Grid.RowDefinitions>

            <TextBlock x:Name="SetText" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock x:Name="PromptText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <controls:PasswordInput x:Name="Input" Grid.Row="2" Label="Password:"
                                    help:HelpControlNameAttachedProperty.ControlName="Password"/>

            <!-- Warning pane (W6): Caps Lock, the attempt, notes, advice — above the buttons -->
            <Border Grid.Row="3" Style="{StaticResource WarningPanelStyle}" Margin="0,10,0,0"
                    help:HelpControlNameAttachedProperty.ControlName="Warning panel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding WarningLevel, Converter={x:Static converters:WarningLevelToIconConverter.Instance}}"
                               FontSize="13" Margin="0,0,6,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="HelpButton" Content="_Help ▶" Click="HelpButton_Click"
                            MinWidth="60" Padding="10,1"
                            ToolTip="Open help for this dialog (F1)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True"
                            Click="OkButton_Click"
                            help:HelpControlNameAttachedProperty.ControlName="OK button"/>
                    <Button Content="Cancel" Width="80" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid><!-- end dialog-content Grid (column 0) -->

        <!-- Help splitter — visible only when the help pane is open -->
        <GridSplitter x:Name="HelpPaneSplitter"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="LightGray"
                      Visibility="Collapsed"/>

        <!-- Help pane — width driven by HelpPaneColumn; starts at 0 (hidden) -->
        <controls:HelpPane x:Name="HelpPaneControl"
                           Grid.Column="2"
                           DataContext="{x:Null}"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
