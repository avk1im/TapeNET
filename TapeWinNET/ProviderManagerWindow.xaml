<Window x:Class="TapeWinNET.ProviderManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:TapeWinNET.Help"
        xmlns:controls="clr-namespace:TapeWinNET.Controls"
        Title="Manage AI Providers"
        Width="720" Height="480"
        MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Outer grid: column 0 = dialog content, column 1 = splitter, column 2 = help pane. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>                                       <!-- help splitter -->
            <ColumnDefinition x:Name="HelpPaneColumn" Width="0" MinWidth="0"/>    <!-- help pane    -->
        </Grid.ColumnDefinitions>

    <!-- Dialog content fills column 0 -->
    <Grid x:Name="HelpOverlayRoot" Grid.Column="0" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Select the provider to use for Help, then click Select. Providers are discovered in the order listed; uncheck a provider to skip it. Built-in providers can be edited and disabled but not removed; use Reset to restore a built-in's default endpoint."/>

        <!-- Provider list -->
        <ListView x:Name="EntryList" Grid.Row="1" Grid.Column="0"
                  help:HelpControlNameAttachedProperty.ControlName="Provider list"
                  SelectionMode="Extended"
                  SelectionChanged="EntryList_SelectionChanged"
                  MouseDoubleClick="EntryList_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Checked="EnabledBox_Changed"
                                          Unchecked="EnabledBox_Changed"
                                          ToolTip="Include this provider in discovery">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNone}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="26">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusBrush}"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           ToolTip="{Binding StatusText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Provider" Width="180"
                                    DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Endpoint" Width="220"
                                    DisplayMemberBinding="{Binding EndpointText}"/>
                    <GridViewColumn Header="Type" Width="70"
                                    DisplayMemberBinding="{Binding OriginText}"/>
                    <GridViewColumn Header="Status" Width="160"
                                    DisplayMemberBinding="{Binding StatusText}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- Side commands -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"
                    help:HelpControlNameAttachedProperty.ControlName="Provider commands">
            <Button x:Name="AddButton"      Content="_Add..."    Margin="0,0,0,6" Padding="8,3" Click="AddButton_Click"/>
            <Button x:Name="EditButton"     Content="_Edit..."   Margin="0,0,0,6" Padding="8,3" Click="EditButton_Click"/>
            <Button x:Name="ResetEntryButton" Content="Re_set"   Margin="0,0,0,6" Padding="8,3" Click="ResetEntryButton_Click"
                    ToolTip="Restore the default endpoint of a built-in provider"/>
            <Button x:Name="RemoveButton"   Content="_Remove"    Margin="0,0,0,6" Padding="8,3" Click="RemoveButton_Click"/>
            <Separator Margin="0,6"/>
            <Button x:Name="UpButton"       Content="Move _Up"   Margin="0,0,0,6" Padding="8,3" Click="UpButton_Click"/>
            <Button x:Name="DownButton"     Content="Move _Down" Margin="0,0,0,6" Padding="8,3" Click="DownButton_Click"/>
            <Separator Margin="0,6"/>
            <Button x:Name="TestButton"     Content="_Test"      Margin="0,0,0,6" Padding="8,3" Click="TestButton_Click"/>
            <Button x:Name="ClearKeyButton" Content="Clear _Key" Margin="0,0,0,6" Padding="8,3" Click="ClearKeyButton_Click"/>
        </StackPanel>

        <!-- Chat model of the selected provider -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0"
                    help:HelpControlNameAttachedProperty.ControlName="Chat model">
            <Label Content="Chat _model:" Target="{Binding ElementName=ModelBox}" Padding="0,0,8,0"
                   VerticalAlignment="Center"/>
            <ComboBox x:Name="ModelBox" MinWidth="280"
                      SelectionChanged="ModelBox_SelectionChanged"/>
        </StackPanel>

        <TextBlock x:Name="StatusLine" Grid.Row="3" Grid.ColumnSpan="2"
                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="Gray"/>

        <!-- Dialog buttons -->
        <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="HelpButton" DockPanel.Dock="Left" Content="_Help ▶" Click="HelpButton_Click"
                    MinWidth="60" Padding="10,1"
                    ToolTip="Open help for this dialog (F1)"/>
            <Button DockPanel.Dock="Left" Content="Reset to Defaults" Width="130"
                    Margin="16,0,0,0" Padding="8,3" Click="ResetButton_Click"
                    help:HelpControlNameAttachedProperty.ControlName="Reset to Defaults"/>
            <Button DockPanel.Dock="Right" Content="Cancel" Width="90" Padding="8,3"
                    IsCancel="True"/>
            <Button x:Name="SelectButton" DockPanel.Dock="Right" Content="_Select" Width="90"
                    Margin="0,0,8,0" Padding="8,3" IsDefault="True" Click="SelectButton_Click"/>
        </DockPanel>
    </Grid><!-- end dialog-content Grid (column 0) -->

        <!-- Help splitter — visible only when the help pane is open -->
        <GridSplitter x:Name="HelpPaneSplitter"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="LightGray"
                      Visibility="Collapsed"/>

        <!-- Help pane — width driven by HelpPaneColumn; starts at 0 (hidden) -->
        <controls:HelpPane x:Name="HelpPaneControl"
                           Grid.Column="2"
                           DataContext="{x:Null}"
                           Visibility="Collapsed"/>

    </Grid>
</Window>
