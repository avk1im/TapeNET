<Window x:Class="TapeWinNET.MediaMismatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Identity Check"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- icon + headline -->
            <RowDefinition Height="Auto"/>   <!-- severity / detail pane -->
            <RowDefinition Height="Auto"/>   <!-- header description (monospace-ish) -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Icon and headline -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="GlyphTextBlock" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeadlineTextBlock" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Severity-graded detail pane (colours set in code-behind per severity) -->
        <Border x:Name="DetailBorder"
                Grid.Row="1"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <TextBlock x:Name="DetailTextBlock" TextWrapping="Wrap"/>
        </Border>

        <!-- The offending header's own description -->
        <Border Grid.Row="2"
                Background="#FFF3F3F3"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,16">
            <TextBlock x:Name="HeaderDescriptionTextBlock"
                       TextWrapping="Wrap"
                       FontFamily="Consolas, Courier New, monospace"
                       FontSize="12"/>
        </Border>

        <!-- Buttons: Retry / Proceed / ProceedAlways / Abort (shown per allowed set) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton"         MinWidth="150" Margin="0,0,8,0"  Click="RetryButton_Click"/>
            <Button x:Name="ProceedButton"       MinWidth="150" Margin="0,0,8,0"  Click="ProceedButton_Click"/>
            <Button x:Name="ProceedAlwaysButton" MinWidth="150" Margin="0,0,8,0"  Click="ProceedAlwaysButton_Click"/>
            <Button x:Name="AbortButton"         MinWidth="90"  Margin="24,0,0,0" Click="AbortButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
