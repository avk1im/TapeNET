<Window x:Class="TapeWinNET.CalibrationProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TapeWinNET.ViewModels"
        xmlns:controls="clr-namespace:TapeWinNET.Controls"
        xmlns:help="clr-namespace:TapeWinNET.Help"
        d:DataContext="{d:DesignInstance Type=vm:CalibrationProfilesViewModel}"
        mc:Ignorable="d"
        Title="Calibration Profiles"
        Height="560" Width="620"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="HelpPaneColumn" Width="0" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="HelpOverlayRoot" Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Every calibration profile ever saved is listed below. Select one to review it, apply it to the currently loaded media, or remove it."
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Grid Grid.Row="1" Margin="0,0,0,12"
                  help:HelpControlNameAttachedProperty.ControlName="Profile selector">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="ProfileKey"/>
            </Grid>

            <GroupBox Grid.Row="2" Header="Measured Result" Margin="0,0,0,12"
                      help:HelpControlNameAttachedProperty.ControlName="Measured Result">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Reported at BOM:" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReportedCapacityAtBomDisplay}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Measured capacity:" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CapacityActualDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Phantom free at EOM:" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhantomFreeAtEomDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="EW landmark:" Margin="0,0,8,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EarlyWarningDisplay}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="EW → EOM:" Margin="0,0,8,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EwToEomDistanceDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Reported → Actual Remaining Curve"
                      help:HelpControlNameAttachedProperty.ControlName="Calibration curve">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <controls:CalibrationCurveControl Grid.Row="0"
                                                      Calibration="{Binding SelectedProfile}"/>

                    <TextBlock Grid.Row="1"
                               Text="The orange tail band magnifies the EW → EOM region with a split X-axis."
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               TextAlignment="Right"/>
                </Grid>
            </GroupBox>

            <TextBlock Grid.Row="4"
                       Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource WarningFg.Info}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Grid.Row="5" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="HelpButton" Content="_Help ▶" Click="HelpButton_Click"
                            MinWidth="60" Padding="10,1"
                            ToolTip="Open help for this dialog (F1)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Apply" Command="{Binding ApplyCommand}"
                            Width="100" Margin="0,0,8,0"/>
                    <Button Content="Remove" Command="{Binding RemoveCommand}"
                            Width="100" Margin="0,0,8,0"/>
                    <Button Content="Close" Width="80" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter x:Name="HelpPaneSplitter"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="LightGray"
                      Visibility="Collapsed"/>

        <controls:HelpPane x:Name="HelpPaneControl"
                           Grid.Column="2"
                           DataContext="{x:Null}"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
