<Window x:Class="TapeWinNET.ScanMediaWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="clr-namespace:TapeWinNET.ViewModels"
		xmlns:controls="clr-namespace:TapeWinNET.Controls"
		xmlns:help="clr-namespace:TapeWinNET.Help"
		d:DataContext="{d:DesignInstance Type=vm:ScanMediaViewModel}"
		mc:Ignorable="d"
		Title="Scan Media"
		SizeToContent="Height" Width="480"
		ResizeMode="NoResize"
		WindowStartupLocation="CenterOwner"
		ShowInTaskbar="False"
		PreviewKeyDown="Window_PreviewKeyDown">

	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
	</Window.InputBindings>

	<!-- Outer grid: column 0 = dialog content, column 1 = splitter, column 2 = help pane -->
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition x:Name="HelpPaneColumn" Width="0" MinWidth="0"/>
		</Grid.ColumnDefinitions>

		<StackPanel x:Name="HelpOverlayRoot" Grid.Column="0" Margin="16">
			<TextBlock Text="Surveys the cartridge from the beginning and lists everything that can be identified on it - with no table of contents needed."
					   TextWrapping="Wrap" Margin="0,0,0,12"/>

			<GroupBox Header="Options" help:HelpControlNameAttachedProperty.ControlName="Options">
				<StackPanel Margin="8">
					<CheckBox Content="Try to recover the table of contents"
							  IsChecked="{Binding RecoverTocCopies}" Margin="0,0,0,10"/>

					<TextBlock Text="Save scan map to:" Margin="0,0,0,4"/>
					<DockPanel>
						<Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearMapFolderCommand}"
								Padding="8,1" Margin="6,0,0,0"/>
						<Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseMapFolderCommand}"
								Padding="8,1" Margin="6,0,0,0"/>
						<TextBlock Text="{Binding MapExportFolderDisplay}" VerticalAlignment="Center"
								   TextTrimming="CharacterEllipsis" ToolTip="{Binding MapExportFolderDisplay}"/>
					</DockPanel>
				</StackPanel>
			</GroupBox>

			<Border Style="{StaticResource WarningPanelStyle}" Margin="0,12,0,0">
				<TextBlock Text="Reads the whole media; nothing is written." TextWrapping="Wrap"/>
			</Border>

			<Grid Margin="0,16,0,0">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
					<Button x:Name="HelpButton" Content="_Help ▶" Click="HelpButton_Click"
							MinWidth="60" Padding="10,1"
							ToolTip="Open help for this dialog (F1)"/>
				</StackPanel>
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Margin="0,0,8,0" IsCancel="True"/>
					<Button Content="Scan" Command="{Binding StartCommand}" Width="90" IsDefault="True"/>
				</StackPanel>
			</Grid>
		</StackPanel>

		<!-- Help splitter — visible only when the help pane is open -->
		<GridSplitter x:Name="HelpPaneSplitter" Grid.Column="1" Width="4"
					  HorizontalAlignment="Center" VerticalAlignment="Stretch"
					  Background="LightGray" Visibility="Collapsed"/>

		<!-- Help pane — width driven by HelpPaneColumn; starts at 0 (hidden) -->
		<controls:HelpPane x:Name="HelpPaneControl" Grid.Column="2"
						   DataContext="{x:Null}" Visibility="Collapsed"/>
	</Grid>
</Window>
