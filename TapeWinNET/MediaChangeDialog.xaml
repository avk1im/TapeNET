<Window x:Class="TapeWinNET.MediaChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Change Required"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- glyph + headline -->
            <RowDefinition Height="Auto"/>   <!-- message (semi-bold) + detail -->
            <RowDefinition Height="Auto"/>   <!-- notice pane, graded by severity -->
            <RowDefinition Height="Auto"/>   <!-- code pane (monospace): header description, error -->
            <RowDefinition Height="Auto"/>   <!-- buttons, built in code-behind -->
        </Grid.RowDefinitions>

        <!-- Glyph and headline -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="GlyphTextBlock" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeadlineTextBlock" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
        </StackPanel>

        <!-- Message and detail (each collapses when empty) -->
        <StackPanel Grid.Row="1">
            <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock x:Name="DetailTextBlock" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Notice pane: colours set in code-behind per severity (info / warning / error) -->
        <Border x:Name="NoticeBorder"
                Grid.Row="2"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <TextBlock x:Name="NoticeTextBlock" TextWrapping="Wrap"/>
        </Border>

        <!-- Code pane: verbatim text such as a header description or a diagnosis -->
        <Border x:Name="CodeBorder"
                Grid.Row="3"
                Background="#FFF3F3F3"
                BorderBrush="#FFD0D0D0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,12">
            <TextBlock x:Name="CodeTextBlock"
                       TextWrapping="Wrap"
                       FontFamily="Consolas, Courier New, monospace"
                       FontSize="12"/>
        </Border>

        <!-- Buttons -->
        <StackPanel x:Name="ButtonPanel" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,4,0,0"/>
    </Grid>
</Window>
