<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>TapeWinNET.App</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
	<AssemblyName>TapeWin</AssemblyName>
	<!-- Enable IDE0005 reports during build and dotnet format -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CS1591;CS1573;CS0419;</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU' Or '$(Configuration)|$(Platform)'=='ReleaseTest|AnyCPU'">
    <NoWarn>1701;1702;CS1591;CS1573;CS0419;</NoWarn>
  </PropertyGroup>

  <Import Project="..\Versioning.targets" />

  <ItemGroup>
    <Compile Remove="Services\BackupProgressHandler.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="4nxbxwuu.xfh~" />
  </ItemGroup>

  <!-- Help content embedded into the assembly for EmbeddedResourceHelpContentSource -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Help\**\*.md" />
  </ItemGroup>
	
  <!--
	Semantic help search (see docs/Design-TapeWinHelp.md, "Semantic search").
	 The embedding model is exchangeable: point HelpEmbeddingModelDir at any folder holding a
	 BERT-style model.onnx + vocab.txt and set the matching id/dimension (override on the command
	 line or in Directory.Build.props). When the model folder is missing, everything below is
	 inert and help runs in lexical (or lexical-RAG) mode.
  -->
  <PropertyGroup>
	<HelpEmbeddingModelDir Condition="'$(HelpEmbeddingModelDir)' == ''">$(USERPROFILE)\ONNX\Models\all-MiniLM-L6-v2</HelpEmbeddingModelDir>
	<HelpEmbeddingModelId Condition="'$(HelpEmbeddingModelId)' == ''">all-MiniLM-L6-v2</HelpEmbeddingModelId>
	<HelpEmbeddingDimension Condition="'$(HelpEmbeddingDimension)' == ''">384</HelpEmbeddingDimension>
	<HelpEmbeddingMaxTokens Condition="'$(HelpEmbeddingMaxTokens)' == ''">256</HelpEmbeddingMaxTokens>
	<HelpEmbeddingsEnabled Condition="'$(HelpEmbeddingsEnabled)' == '' And Exists('$(HelpEmbeddingModelDir)\model.onnx') And Exists('$(HelpEmbeddingModelDir)\vocab.txt')">true</HelpEmbeddingsEnabled>
	<HelpEmbeddingsOutDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)HelpEmbeddings\</HelpEmbeddingsOutDir>
	<HelpIndexBuilderProject>..\HelpNET\Tools\HelpIndexBuilder\HelpIndexBuilder.csproj</HelpIndexBuilderProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(HelpEmbeddingsEnabled)' == 'true'">
	<!-- Runtime model: copied next to the executable; loaded by HelpEmbeddingModelLoader -->
	<None Include="$(HelpEmbeddingModelDir)\model.onnx" Link="HelpModel\model.onnx" CopyToOutputDirectory="PreserveNewest" />
	<None Include="$(HelpEmbeddingModelDir)\vocab.txt" Link="HelpModel\vocab.txt" CopyToOutputDirectory="PreserveNewest" />
	<!-- Model id / dimension baked into the assembly so runtime and bundle always agree -->
	<AssemblyMetadata Include="HelpEmbeddingModelId" Value="$(HelpEmbeddingModelId)" />
	<AssemblyMetadata Include="HelpEmbeddingDimension" Value="$(HelpEmbeddingDimension)" />
	<AssemblyMetadata Include="HelpEmbeddingMaxTokens" Value="$(HelpEmbeddingMaxTokens)" />
  </ItemGroup>

  <!-- Incremental: re-indexes only when a help topic or the model changes -->
  <Target Name="BuildHelpEmbeddings"
		  Condition="'$(HelpEmbeddingsEnabled)' == 'true'"
		  BeforeTargets="AssignTargetPaths"
		  Inputs="@(EmbeddedResource->WithMetadataValue('Extension', '.md'));$(HelpEmbeddingModelDir)\model.onnx;$(HelpEmbeddingModelDir)\vocab.txt;$(MSBuildProjectFullPath)"
		  Outputs="$(HelpEmbeddingsOutDir)embeddings.bin">
	<MSBuild Projects="$(HelpIndexBuilderProject)" Targets="Build" Properties="Configuration=Release" RemoveProperties="Platform;RuntimeIdentifier;LocSourceDir">
	  <Output TaskParameter="TargetOutputs" PropertyName="HelpIndexBuilderPath" />
	</MSBuild>
	<Exec Command="dotnet &quot;$(HelpIndexBuilderPath)&quot; --content &quot;$(MSBuildProjectDirectory)\Resources\Help&quot; --model &quot;$(HelpEmbeddingModelDir)\model.onnx&quot; --vocab &quot;$(HelpEmbeddingModelDir)\vocab.txt&quot; --model-id $(HelpEmbeddingModelId) --dim $(HelpEmbeddingDimension) --max-tokens $(HelpEmbeddingMaxTokens) --output &quot;$(HelpEmbeddingsOutDir.TrimEnd('\'))&quot;" />
  </Target>

  <!-- Embed the generated bundle under the names EmbeddedResourceHelpContentSource expects -->
  <Target Name="EmbedHelpEmbeddings"
		  Condition="'$(HelpEmbeddingsEnabled)' == 'true'"
		  AfterTargets="BuildHelpEmbeddings"
		  BeforeTargets="AssignTargetPaths">
	<ItemGroup>
	  <EmbeddedResource Include="$(HelpEmbeddingsOutDir)embeddings.bin" LogicalName="$(RootNamespace).Resources.Help._index.embeddings.bin" />
	  <EmbeddedResource Include="$(HelpEmbeddingsOutDir)embeddings.meta.json" LogicalName="$(RootNamespace).Resources.Help._index.embeddings.meta.json" />
	  <EmbeddedResource Include="$(HelpEmbeddingsOutDir)embeddings.index.json" LogicalName="$(RootNamespace).Resources.Help._index.embeddings.index.json" />
	</ItemGroup>
  </Target>

  <ItemGroup>
	<ProjectReference Include="..\AiNET\AiNET.csproj" />
	<ProjectReference Include="..\FclNET\FclNET.csproj" />
	<ProjectReference Include="..\FclAiNET\FclAiNET.csproj" />
	<ProjectReference Include="..\HelpNET\HelpNET.csproj" />
	<ProjectReference Include="..\TapeLibNET\TapeLibNET.csproj" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
		<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.366">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Memory" Version="4.6.3" />
	</ItemGroup>

  <!--
	Localization build-time source swap (see docs/Design-TapeLoc.md §11).
	 When LocSourceDir is set (e.g. by tools/publish-loc.ps1), the canonical
	 English .cs/.xaml sources are replaced by the AI-generated translated
	 variant under that directory. When LocSourceDir is empty (the default),
	 this ItemGroup is inert and the normal English build is unaffected.
  -->
  <ItemGroup Condition="'$(LocSourceDir)' != ''">
	<!-- Drop the default-globbed canonical sources. -->
	<Compile Remove="**\*.cs" />
	<Page Remove="**\*.xaml" />
	<!-- Re-include from the translated variant, preserving link paths so output
		 structure and XAML code-behind pairing stay identical. -->
	<Compile Include="$(LocSourceDir)\**\*.cs" Exclude="$(LocSourceDir)\**\bin\**;$(LocSourceDir)\**\obj\**">
	  <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
	</Compile>
	<Page Include="$(LocSourceDir)\**\*.xaml" Exclude="$(LocSourceDir)\**\bin\**;$(LocSourceDir)\**\obj\**">
	  <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
	</Page>
	<!-- Re-apply the canonical exclusion that the default ItemGroup carried. -->
	<Compile Remove="$(LocSourceDir)\Services\BackupProgressHandler.cs" />
  </ItemGroup>

</Project>
