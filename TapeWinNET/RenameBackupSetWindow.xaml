<Window x:Class="TapeWinNET.RenameBackupSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TapeWinNET.ViewModels"
        xmlns:controls="clr-namespace:TapeWinNET.Controls"
        xmlns:converters="clr-namespace:TapeWinNET.Converters"
        d:DataContext="{d:DesignInstance Type=vm:RenameBackupSetViewModel}"
        mc:Ignorable="d"
        Title="Rename Backup Set"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisLocal"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- set -->
            <RowDefinition Height="Auto"/>  <!-- current password -->
            <RowDefinition Height="Auto"/>  <!-- name -->
            <RowDefinition Height="Auto"/>  <!-- change password -->
            <RowDefinition Height="Auto"/>  <!-- warning pane -->
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SetDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- The current password first: for a locked set it unlocks the name (Design-Encryption §11.1.6) -->
        <controls:PasswordInput x:Name="CurrentPasswordInput" Grid.Row="1"
                                Label="Current password:"
                                Message="{Binding CurrentPasswordError, Mode=OneWay}"
                                IsVerified="{Binding CurrentPasswordVerified, Mode=OneWay}"
                                PasswordSource="{Binding CurrentPasswordSource, Mode=OneWayToSource}"
                                RetryDelaySource="{Binding PasswordRetryDelaySource}"
                                Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVisLocal}}"
                                LostKeyboardFocus="CurrentPasswordInput_LostKeyboardFocus"
                                Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Name:" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsNameEnabled}"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <Expander Grid.Row="3" Header="Change password"
                  IsExpanded="{Binding ChangePassword}"
                  Visibility="{Binding IsEncrypted, Converter={StaticResource BoolToVisLocal}}">
            <controls:NewPasswordInput Margin="0,8,0,0"
                                       PasswordSource="{Binding NewPasswordSource, Mode=OneWayToSource}"/>
        </Expander>

        <!-- Warning pane (W6): the check to do, the advice, the multi-volume note — above the buttons -->
        <Border Grid.Row="4" Style="{StaticResource WarningPanelStyle}" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding WarningLevel, Converter={x:Static converters:WarningLevelToIconConverter.Instance}}"
                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="Cancel" Width="80" IsCancel="True" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
