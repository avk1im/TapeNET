<Window x:Class="TapeWinNET.CalibrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TapeWinNET.ViewModels"
        xmlns:converters="clr-namespace:TapeWinNET.Converters"
        xmlns:controls="clr-namespace:TapeWinNET.Controls"
        xmlns:help="clr-namespace:TapeWinNET.Help"
        xmlns:services="clr-namespace:TapeLibNET.Services;assembly=tapelib"
        d:DataContext="{d:DesignInstance Type=vm:CalibrationRunViewModel}"
        mc:Ignorable="d"
        Title="Calibrate Media"
        Height="440" Width="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:BoolToVisibilityCollapsedConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="HelpPaneColumn" Width="0" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="HelpOverlayRoot" Grid.Column="0" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Destructive calibration writes the cartridge to end-of-media to measure the real capacity and the early-warning landmark."
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1" Style="{StaticResource WarningPanelStyle}" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding WarningLevel, Converter={x:Static converters:WarningLevelToIconConverter.Instance}}"
                               FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding WarningMessage}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="OperationScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="Profile Summary" VerticalAlignment="Top"
                              help:HelpControlNameAttachedProperty.ControlName="Profile Summary">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Vendor:" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Vendor}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Product:" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Product}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Revision:" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Revision}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Capacity:" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CapacityDisplay}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Bucket:" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CapacityBucketDisplay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Operation" VerticalAlignment="Top" Margin="0,12,0,0"
                              help:HelpTopicIdAttachedProperty.TopicId="dialog.calibrate"
                              help:HelpControlNameAttachedProperty.ControlName="Operation">
                        <StackPanel Margin="8">
                            <RadioButton Content="New run — calibrate fully from the beginning of the cartridge"
                                         IsChecked="{Binding IsNewRunMode}"
                                         Margin="0,0,0,6"/>
                            <RadioButton Content="Resume — continue an interrupted calibration run to the end"
                                         IsChecked="{Binding IsResumeMode}"
                                         Margin="0,0,0,6"/>
                            <RadioButton Content="Recalibrate — re-measure only the tail of a completed run and compare"
                                         IsChecked="{Binding IsRecalibrateMode}"/>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsInspectAvailable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Inspect the cartridge to determine if it allows Resume or Recalibrate (this is read-only!)"
                                           Foreground="Gray"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <Button Content="Inspect Media"
                                        Command="{Binding InspectMediaCommand}"
                                        HorizontalAlignment="Left"
                                        MinWidth="110" Padding="8,2"
                                        Margin="0,0,0,6"/>
                                <Border x:Name="InspectionResultBorder"
                                        Visibility="{Binding HasInspectionResult, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource WarningPanelStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InspectionLevel}" Value="{x:Static services:ServiceReportLevel.Info}">
                                                    <Setter Property="Background" Value="{StaticResource WarningBg.Info}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBr.Info}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InspectionLevel}" Value="{x:Static services:ServiceReportLevel.Warning}">
                                                    <Setter Property="Background" Value="{StaticResource WarningBg.Warning}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBr.Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InspectionLevel}" Value="{x:Static services:ServiceReportLevel.Failed}">
                                                    <Setter Property="Background" Value="{StaticResource WarningBg.Failed}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBr.Failed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InspectionLevel}" Value="{x:Static services:ServiceReportLevel.Error}">
                                                    <Setter Property="Background" Value="{StaticResource WarningBg.Error}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBr.Error}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding InspectionLevel}" Value="{x:Static services:ServiceReportLevel.Completed}">
                                                    <Setter Property="Background" Value="{StaticResource WarningBg.Completed}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource WarningBr.Completed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding InspectionLevel, Converter={x:Static converters:WarningLevelToIconConverter.Instance}}"
                                                   FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding InspectionSummary}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Options" VerticalAlignment="Top" Margin="0,12,0,0"
                              help:HelpControlNameAttachedProperty.ControlName="Calibration options">
                        <CheckBox Margin="8"
                                  Content="Eject media when done"
                                  IsChecked="{Binding EjectWhenDone}"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <CheckBox Grid.Row="3"
                      Margin="0,12,0,0"
                      IsChecked="{Binding IsConfirmChecked}"
                      help:HelpControlNameAttachedProperty.ControlName="Confirm calibration">
                <TextBlock Text="I understand that this destroys all content on the scratch cartridge."
                           Foreground="{DynamicResource WarningFg.Error}"
                           TextWrapping="Wrap"/>
            </CheckBox>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="HelpButton" Content="_Help ▶" Click="HelpButton_Click"
                            MinWidth="60" Padding="10,1"
                            ToolTip="Open help for this dialog (F1)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                            Width="80" Margin="0,0,8,0" IsCancel="True" IsDefault="True"/>
                    <Button Content="Calibrate" Command="{Binding StartCommand}"
                            Width="90" Foreground="{DynamicResource WarningFg.Error}"
                            help:HelpControlNameAttachedProperty.ControlName="Calibrate button"/>
                </StackPanel>
            </Grid>
        </Grid>

        <GridSplitter x:Name="HelpPaneSplitter"
                      Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="LightGray"
                      Visibility="Collapsed"/>

        <controls:HelpPane x:Name="HelpPaneControl"
                           Grid.Column="2"
                           DataContext="{x:Null}"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
