<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tapelib</AssemblyName>
	<!-- Enable IDE0005 reports during build and dotnet format -->
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn>1701;1702;CS1591;CS1573;CS0419;</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU' Or '$(Configuration)|$(Platform)'=='ReleaseTest|AnyCPU'">
    <NoWarn>1701;1702;CS1591;CS1573;CS0419;</NoWarn>
  </PropertyGroup>

  <Import Project="..\Versioning.targets" />

  <ItemGroup>
    <Compile Remove="Excluded Files\**" />
    <EmbeddedResource Remove="Excluded Files\**" />
    <None Remove="Excluded Files\**" />
  </ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
			<_Parameter1>windows5.1.2600</_Parameter1>
		</AssemblyAttribute>
		<InternalsVisibleTo Include="tapesvc" />  <!-- the ASSEMBLY name of TapeServiceNET -->
		<InternalsVisibleTo Include="TapeLibNET.Tests" />
		<InternalsVisibleTo Include="TapeConNET.Tests" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="TapeWinNET.csproj" />
	</ItemGroup>

	<ItemGroup>
	<PackageReference Include="Google.Protobuf" Version="3.36.2" />
	<PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
	<PackageReference Include="Grpc.Tools" Version="2.84.0">
	  <PrivateAssets>all</PrivateAssets>
	  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	</PackageReference>
	<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
	<PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.366">
	  <!-- <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets> -->
	  <PrivateAssets>all</PrivateAssets>
	</PackageReference>
	<PackageReference Include="System.IO.Hashing" Version="10.0.13" />
	<PackageReference Include="System.Memory" Version="4.6.3" />
	<PackageReference Include="ZstdNet" Version="1.5.7" />
  </ItemGroup>

  <ItemGroup>
	<!-- Generate both client and server stubs here so TapeServiceNET can
		 reference the server base class without regenerating message types. -->
	<Protobuf Include="Remote\TapeDrive.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
